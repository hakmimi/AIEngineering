# Copy to .env and fill in. .env is git-ignored; this example file is committed and must never contain real secrets.
# Every variable the code reads is listed here (a test fails if one is missing).

# --- Required ---------------------------------------------------------------------------------------------
OPENAI_API_KEY=sk-your-key-here

# --- Security (optional) ----------------------------------------------------------------------------------
# When set, protected endpoints require the header  X-API-Key: <value>
APP_API_KEY=
RATE_LIMIT_PER_MINUTE=60

# --- Models -----------------------------------------------------------------------------------------------
LLM_MODEL=gpt-4.1-mini
EMBEDDING_MODEL=text-embedding-3-small
OPENAI_TIMEOUT_SECONDS=20
OPENAI_MAX_RETRIES=0          # 0 = the app-level retry (RETRY_*) is the only retry layer
RETRY_ATTEMPTS=3
RETRY_BASE_DELAY=0.5

# --- Input limits -----------------------------------------------------------------------------------------
MAX_QUERY_LENGTH=1000
MAX_TOP_K=10
MIN_QUERY_WORDS=2
COMPLEX_QUERY_WORDS=12

# --- Retrieval --------------------------------------------------------------------------------------------
RETRIEVAL_THRESHOLD=0.40      # best score below this -> refuse without calling the LLM
MIN_CHUNK_SCORE=0.30
MIN_CHUNK_WORDS=5
MIN_CONTEXT_CHUNKS=1
KEYWORD_BOOST=0.10
TOPIC_BOOST=0.15
RELATIVE_SCORE_MARGIN=0.12
COMPLEX_SCORE_MARGIN=0.30
FAISS_CANDIDATE_MULTIPLIER=3
EXPAND_SIBLINGS=1
MAX_CONTEXT_CHUNKS=8

# --- Prompt / cost ----------------------------------------------------------------------------------------
MAX_CONTEXT_CHARS=6000
MAX_CONTEXT_TOKENS=400
JSON_SCHEMA_IN_PROMPT=0
RAG_PROMPT_VERSION=v1
PRICING_JSON={}               # e.g. {"gpt-4.1-mini": {"input": 0.40, "output": 1.60}}  (USD per 1M tokens)

# --- Routing ----------------------------------------------------------------------------------------------
LLM_ROUTING=0                 # 1 = let the LLM classify intent (extra call per request)

# --- Memory -----------------------------------------------------------------------------------------------
MEMORY_MAX_TURNS=6
MEMORY_MAX_SESSIONS=500
MEMORY_PROMPT_CHARS=1200

# --- Observability ----------------------------------------------------------------------------------------
LOG_FORMAT=json               # json | text
LOG_USER_TEXT=0               # 1 = include user text in logs (debugging only)
SLOW_REQUEST_MS=3000
