# Copy to .env and fill in. Never commit .env. Only OPENAI_API_KEY is a secret; everything else has a default (see config.yaml).

# --- secrets (environment only; ignored if placed in config.yaml) ---
OPENAI_API_KEY=
# If set, every protected endpoint requires the header X-API-Key: <this value>
APP_API_KEY=

# --- behaviour (optional; overrides config.yaml) ---
# DECISION_MODE=graph
# ALLOWED_MODES=graph            # baseline/ai lack the safety layers - keep production on graph only
# LLM_MODEL=gpt-4.1-mini
# LLM_TEMPERATURE=0
# FAST_PATH_ENABLED=true
# JOB_WORKERS=16
# RATE_LIMIT_PER_MINUTE=600

# --- storage (the container sets these to a volume) ---
# AUDIT_DB_PATH=/var/lib/agent/audit.db
# JOBS_DB_PATH=/var/lib/agent/jobs.db
# LOG_FORMAT=json               # json | text
